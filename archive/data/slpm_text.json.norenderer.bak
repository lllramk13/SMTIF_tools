{
  "text_slpm": [
    {
      "id": "SLPM-000E602C",
      "offset": "000E602C",
      "max_bytes": 20,
      "source": "魔法を使用します{72FF}",
      "translation": "使用魔法{72FF}",
      "translation_origin": "existing_exact_match"
    },
    {
      "id": "SLPM-000E6040",
      "offset": "000E6040",
      "max_bytes": 46,
      "source": "アイテムを使用/整頓/並び替え/破棄します{72FF}",
      "translation": "使用道具/整理/排序/丢弃{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E606E",
      "offset": "000E606E",
      "max_bytes": 20,
      "source": "装備を変更します{72FF}",
      "translation": "变更装备{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6082",
      "offset": "000E6082",
      "max_bytes": 30,
      "source": "詳細ステータスを表示します{72FF}",
      "translation": "显示详细状态{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E60A0",
      "offset": "000E60A0",
      "max_bytes": 20,
      "source": "隊列を変更します{72FF}",
      "translation": "调整队列{72FF}",
      "translation_origin": "manual"
    },
    {
      "id": "SLPM-000E60B4",
      "offset": "000E60B4",
      "max_bytes": 32,
      "source": "ＣＯＭＰ内の仲魔を召喚します{72FF}",
      "translation": "召唤ＣＯＭＰ里的仲魔{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E60D4",
      "offset": "000E60D4",
      "max_bytes": 30,
      "source": "仲魔をＣＯＭＰ内に戻します{72FF}",
      "translation": "让仲魔回到ＣＯＭＰ{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E60F2",
      "offset": "000E60F2",
      "max_bytes": 30,
      "source": "仲魔をパーティから外します{72FF}",
      "translation": "让仲魔离开队伍{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6110",
      "offset": "000E6110",
      "max_bytes": 40,
      "source": "今まで行った場所のＭＡＰを表示します{72FF}",
      "translation": "显示以往去过的地点的ＭＡＰ{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6138",
      "offset": "000E6138",
      "max_bytes": 40,
      "source": "パーティ全員の回復を自動的に行います{72FF}",
      "translation": "队伍全员自动进行回复{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6160",
      "offset": "000E6160",
      "max_bytes": 32,
      "source": "今まで倒した悪魔を解析します{72FF}",
      "translation": "解析以往打倒过的恶魔{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6180",
      "offset": "000E6180",
      "max_bytes": 26,
      "source": "誰の魔法を使いますか？{72FF}",
      "translation": "要使用谁的魔法？{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E619A",
      "offset": "000E619A",
      "max_bytes": 26,
      "source": "どの魔法を使いますか？{72FF}",
      "translation": "要使用哪个魔法？{72FF}",
      "translation_origin": "existing_exact_match"
    },
    {
      "id": "SLPM-000E61B4",
      "offset": "000E61B4",
      "max_bytes": 24,
      "source": "アイテムを使用します{72FF}",
      "translation": "使用道具{72FF}",
      "translation_origin": "existing_exact_match"
    },
    {
      "id": "SLPM-000E61CC",
      "offset": "000E61CC",
      "max_bytes": 24,
      "source": "アイテムを整頓します{72FF}",
      "translation": "整理道具{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E61E4",
      "offset": "000E61E4",
      "max_bytes": 26,
      "source": "アイテムを並び替えます{72FF}",
      "translation": "给道具排序{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E61FE",
      "offset": "000E61FE",
      "max_bytes": 24,
      "source": "アイテムを破棄します{72FF}",
      "translation": "丢弃道具{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6216",
      "offset": "000E6216",
      "max_bytes": 30,
      "source": "どのアイテムを使いますか？{72FF}",
      "translation": "要使用哪个道具？{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6234",
      "offset": "000E6234",
      "max_bytes": 20,
      "source": "誰に使いますか？{72FF}",
      "translation": "要对谁使用？{72FF}",
      "translation_origin": "existing_exact_match"
    },
    {
      "id": "SLPM-000E6248",
      "offset": "000E6248",
      "max_bytes": 38,
      "source": "移動元のアイテムを選択してください{72FF}",
      "translation": "请选择要移动的道具{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E626E",
      "offset": "000E626E",
      "max_bytes": 38,
      "source": "移動先のアイテムを選択してください{72FF}",
      "translation": "请选择要移动到的位置{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6294",
      "offset": "000E6294",
      "max_bytes": 30,
      "source": "どのアイテムを捨てますか？{72FF}",
      "translation": "要丢弃哪个道具？{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E62B2",
      "offset": "000E62B2",
      "max_bytes": 30,
      "source": "誰のステータスを見ますか？{72FF}",
      "translation": "要查看谁的状态？{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E62D0",
      "offset": "000E62D0",
      "max_bytes": 34,
      "source": "移動元のアイテムを選んで下さい{72FF}",
      "translation": "请选择要移动的道具{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E62F2",
      "offset": "000E62F2",
      "max_bytes": 34,
      "source": "移動先のアイテムを選んで下さい{72FF}",
      "translation": "请选择要移动到的位置{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6314",
      "offset": "000E6314",
      "max_bytes": 26,
      "source": "呼び出せる仲魔はいない{72FF}",
      "translation": "没有能召唤出来的仲魔{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E632E",
      "offset": "000E632E",
      "max_bytes": 22,
      "source": "誰を召喚しますか？{72FF}",
      "translation": "要召唤谁呢？{72FF}",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6344",
      "offset": "000E6344",
      "max_bytes": 18,
      "source": "{名字1}を呼び出した▽",
      "translation": "将{名字1}召唤出来了。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6356",
      "offset": "000E6356",
      "max_bytes": 24,
      "source": "{名字1}をＣＯＭＰに戻した▽",
      "translation": "让{名字1}返回ＣＯＭＰ了。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E636E",
      "offset": "000E636E",
      "max_bytes": 18,
      "source": "{主角}達は回復した▽",
      "translation": "{主角}等人回复了。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6380",
      "offset": "000E6380",
      "max_bytes": 24,
      "source": "しかし効果は無かった▽",
      "translation": "但是没有效果。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6398",
      "offset": "000E6398",
      "max_bytes": 26,
      "source": "種族別に並べて表示します",
      "translation": "根据种族进行排序",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E63B2",
      "offset": "000E63B2",
      "max_bytes": 36,
      "source": "悪魔名の５０音順に並べて表示します",
      "translation": "根据恶魔名的５０音进行排序",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E63D6",
      "offset": "000E63D6",
      "max_bytes": 28,
      "source": "レベル順に並べて表示します",
      "translation": "根据等级大小进行排序",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E63F2",
      "offset": "000E63F2",
      "max_bytes": 26,
      "source": "属性別に並べて表示します",
      "translation": "根据属性进行排序",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E640C",
      "offset": "000E640C",
      "max_bytes": 16,
      "source": "どうしますか？",
      "translation": "要做什么呢？",
      "translation_origin": "existing_exact_match"
    },
    {
      "id": "SLPM-000E641C",
      "offset": "000E641C",
      "max_bytes": 32,
      "source": "ＣＯＭＰを使える状態ではない▽",
      "translation": "现在无法使用ＣＯＭＰ。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E643C",
      "offset": "000E643C",
      "max_bytes": 30,
      "source": "ここではＣＯＭＰを使えない▽",
      "translation": "在这里无法使用ＣＯＭＰ。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E645A",
      "offset": "000E645A",
      "max_bytes": 16,
      "source": "誰を呼び出す？",
      "translation": "要召唤出谁？",
      "translation_origin": "existing_exact_match"
    },
    {
      "id": "SLPM-000E646A",
      "offset": "000E646A",
      "max_bytes": 18,
      "source": "どこに呼び出す？",
      "translation": "要召唤到哪里？",
      "translation_origin": "existing_exact_match"
    },
    {
      "id": "SLPM-000E647C",
      "offset": "000E647C",
      "max_bytes": 22,
      "source": "誰と換えて呼び出す？",
      "translation": "要召唤谁来交换？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6492",
      "offset": "000E6492",
      "max_bytes": 14,
      "source": "換えられない",
      "translation": "无法交换",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E64A0",
      "offset": "000E64A0",
      "max_bytes": 16,
      "source": "お金が足りない",
      "translation": "金钱不够",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E64B0",
      "offset": "000E64B0",
      "max_bytes": 28,
      "source": "属性が違いすぎる悪魔がいる",
      "translation": "存在属性相差过大的恶魔",
      "translation_origin": "existing_exact_match"
    },
    {
      "id": "SLPM-000E64CC",
      "offset": "000E64CC",
      "max_bytes": 16,
      "source": "ＮＯ　ＤＡＴＡ",
      "translation": "ＮＯ　ＤＡＴＡ",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E64DC",
      "offset": "000E64DC",
      "max_bytes": 12,
      "source": "誰を戻す？",
      "translation": "要让谁回去？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E64E8",
      "offset": "000E64E8",
      "max_bytes": 20,
      "source": "戻せる仲魔はいない",
      "translation": "没有能返回的仲魔",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E64FC",
      "offset": "000E64FC",
      "max_bytes": 12,
      "source": "誰を外す？",
      "translation": "要让谁离开？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6508",
      "offset": "000E6508",
      "max_bytes": 18,
      "source": "{名字1}を外しますか？",
      "translation": "要让{名字1}离开吗？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E651A",
      "offset": "000E651A",
      "max_bytes": 10,
      "source": "位置換え",
      "translation": "交换位置",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6524",
      "offset": "000E6524",
      "max_bytes": 22,
      "source": "どのアイテムを見る？",
      "translation": "要查看哪个道具？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E653A",
      "offset": "000E653A",
      "max_bytes": 12,
      "source": "誰の魔法？",
      "translation": "谁的魔法？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6546",
      "offset": "000E6546",
      "max_bytes": 18,
      "source": "どの魔法を使う？",
      "translation": "要使用哪个魔法？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6558",
      "offset": "000E6558",
      "max_bytes": 12,
      "source": "誰に使う？",
      "translation": "让谁使用？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6564",
      "offset": "000E6564",
      "max_bytes": 24,
      "source": "誰の魔法を並べ替える？",
      "translation": "要排列谁的魔法？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E657C",
      "offset": "000E657C",
      "max_bytes": 22,
      "source": "どのアイテムを使う？",
      "translation": "要使用哪个道具？",
      "translation_origin": "existing_exact_match"
    },
    {
      "id": "SLPM-000E6592",
      "offset": "000E6592",
      "max_bytes": 10,
      "source": "並べ替え",
      "translation": "排序",
      "translation_origin": "existing_exact_match"
    },
    {
      "id": "SLPM-000E659C",
      "offset": "000E659C",
      "max_bytes": 14,
      "source": "整頓中．．．",
      "translation": "整理中．．．",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E65AA",
      "offset": "000E65AA",
      "max_bytes": 10,
      "source": "整頓終了",
      "translation": "整理结束",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E65B4",
      "offset": "000E65B4",
      "max_bytes": 24,
      "source": "どのアイテムを捨てる？",
      "translation": "要丢弃哪个道具？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E65CC",
      "offset": "000E65CC",
      "max_bytes": 18,
      "source": "{道具}を捨てるのか？",
      "translation": "要丢弃{道具}吗？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E65DE",
      "offset": "000E65DE",
      "max_bytes": 12,
      "source": "誰の装備？",
      "translation": "谁的装备？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E65EA",
      "offset": "000E65EA",
      "max_bytes": 24,
      "source": "誰のステータスを見る？",
      "translation": "要查看谁的状态？",
      "translation_origin": "manual"
    },
    {
      "id": "SLPM-000E6602",
      "offset": "000E6602",
      "max_bytes": 20,
      "source": "しばし待たれよ！▽",
      "translation": "稍等一会儿吧！▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6616",
      "offset": "000E6616",
      "max_bytes": 26,
      "source": "{名字1}は\n渋々去って行った▽",
      "translation": "{名字1}\n不情不愿地离开了。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6630",
      "offset": "000E6630",
      "max_bytes": 14,
      "source": "よろしいか？",
      "translation": "可以吗？",
      "translation_origin": "existing_exact_match"
    },
    {
      "id": "SLPM-000E663E",
      "offset": "000E663E",
      "max_bytes": 22,
      "source": "何処に転送しますか？",
      "translation": "要传送到哪里？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6654",
      "offset": "000E6654",
      "max_bytes": 34,
      "source": "アイテムが１種類しかありません▽",
      "translation": "道具只有一个种类。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6676",
      "offset": "000E6676",
      "max_bytes": 20,
      "source": "アイテムが一杯だ▽",
      "translation": "道具已满。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E668A",
      "offset": "000E668A",
      "max_bytes": 18,
      "source": "アイテムが無い▽",
      "translation": "没有道具。▽",
      "translation_origin": "manual"
    },
    {
      "id": "SLPM-000E669C",
      "offset": "000E669C",
      "max_bytes": 28,
      "source": "装備できるアイテムが無い▽",
      "translation": "没有可装备的道具。▽",
      "translation_origin": "manual"
    },
    {
      "id": "SLPM-000E66B8",
      "offset": "000E66B8",
      "max_bytes": 22,
      "source": "何も装備していない▽",
      "translation": "什么也没有装备。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E66CE",
      "offset": "000E66CE",
      "max_bytes": 24,
      "source": "{仲魔}は\n能力を回復した▽",
      "translation": "{仲魔}\n恢复了能力。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E66E6",
      "offset": "000E66E6",
      "max_bytes": 20,
      "source": "階段を上りますか？",
      "translation": "要上楼吗？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E66FA",
      "offset": "000E66FA",
      "max_bytes": 20,
      "source": "階段を下りますか？",
      "translation": "要下楼吗？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E670E",
      "offset": "000E670E",
      "max_bytes": 20,
      "source": "使える魔法が無い▽",
      "translation": "没有可用魔法。▽",
      "translation_origin": "manual"
    },
    {
      "id": "SLPM-000E6722",
      "offset": "000E6722",
      "max_bytes": 26,
      "source": "ＣＯＭＰを持っていない▽",
      "translation": "没有ＣＯＭＰ。▽",
      "translation_origin": "manual"
    },
    {
      "id": "SLPM-000E673C",
      "offset": "000E673C",
      "max_bytes": 28,
      "source": "仲魔が一杯だ\n誰か外すか？",
      "translation": "仲魔已经满了。\n要让谁离开吗？",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6758",
      "offset": "000E6758",
      "max_bytes": 24,
      "source": "仲魔にするのを諦めた▽",
      "translation": "放弃成为仲魔了。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6770",
      "offset": "000E6770",
      "max_bytes": 24,
      "source": "話しが通じないようだ▽",
      "translation": "看起来无法对话。▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E6788",
      "offset": "000E6788",
      "max_bytes": 26,
      "source": "だめだ話しにならない！▽",
      "translation": "不行，无法对话！▽",
      "translation_origin": "untranslated"
    },
    {
      "id": "SLPM-000E67A2",
      "offset": "000E67A2",
      "max_bytes": 24,
      "source": "いきなり襲ってきた！▽",
      "translation": "突然袭击了过来！▽",
      "translation_origin": "untranslated"
    },
    {
